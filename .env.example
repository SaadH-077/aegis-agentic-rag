# =============================================================================
#  Agentic RAG Assistant — environment configuration
#  Copy this file to `.env` and fill in the values. Nothing here is required to
#  RUN THE TESTS (they are fully offline/mocked), but you need an LLM provider
#  and embeddings to run the live app.
# =============================================================================

# -----------------------------------------------------------------------------
#  LLM PROVIDER
#  Pick ONE provider. Default is Hugging Face (free serverless inference).
#  Options: huggingface | groq | ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=huggingface

# --- Hugging Face (default) -------------------------------------------------
# Create a free token at https://huggingface.co/settings/tokens (role: "read").
# NOTE: The free tier gives a small monthly inference credit. The agent makes
# several LLM calls per question, so for heavy demoing consider Groq or Ollama
# below (both have free options). Swapping is a one-line change here.
HF_TOKEN=
# Any instruct model served by HF Inference Providers. Smaller = cheaper/faster.
# Good picks: meta-llama/Llama-3.1-8B-Instruct, Qwen/Qwen2.5-7B-Instruct,
#             mistralai/Mistral-7B-Instruct-v0.3, Qwen/Qwen2.5-1.5B-Instruct
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Let HF route to the best available provider, or pin one (e.g. "together", "novita").
HF_PROVIDER=auto

# --- Groq (recommended for heavy use — generous free tier, OpenAI-compatible) -
# Get a free key at https://console.groq.com/keys  then set LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local / offline; needs Ollama installed + a pulled model) --
# https://ollama.com  •  `ollama pull llama3.1`  then set LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Sampling
LLM_TEMPERATURE=0.1
LLM_MAX_NEW_TOKENS=512

# -----------------------------------------------------------------------------
#  EMBEDDINGS
#  api   -> HuggingFaceEndpointEmbeddings (no local download, no torch needed)
#  local -> sentence-transformers on your machine (needs ~90MB + torch;
#           install with: pip install -r requirements-local.txt)
# -----------------------------------------------------------------------------
EMBEDDINGS_MODE=api
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
#  RETRIEVAL / VECTOR STORE
# -----------------------------------------------------------------------------
CORPUS_DIR=data/corpus
VECTORSTORE_DIR=storage/faiss_index
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=3

# -----------------------------------------------------------------------------
#  GRAPH BEHAVIOUR
# -----------------------------------------------------------------------------
MAX_RETRIES=2
ENABLE_WEB_SEARCH=true
# When true, the graph pauses (human-in-the-loop) for approval before searching
# the web. This is the interrupt()/Command(resume=...) demo.
REQUIRE_WEB_SEARCH_APPROVAL=true
WEB_SEARCH_RESULTS=4
# Optional: a free Tavily key (https://tavily.com) for more reliable web results.
# Leave blank to use keyless DuckDuckGo (the default fallback).
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
#  LANGSMITH (tracing + evaluation). Free account: https://smith.langchain.com
#  Set LANGSMITH_TRACING=true and paste your key to light up full tracing.
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# -----------------------------------------------------------------------------
#  API / UI
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Base URL the Streamlit UI uses to reach the FastAPI backend.
API_BASE_URL=http://localhost:8000
